+               }
+             }
+           });
+         }
+ 
+         @Override
+         public void onWrite(SelectionKey couchKey) throws Exception {
+           couchConnection.write(UTF8.encode(req));
+           couchKey.selector().wakeup();
+           couchKey.interestOps(OP_READ);
+         }
+       });
+     }
+   }
+ 
+ }

