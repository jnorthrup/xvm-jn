+   public boolean recognize(ByteBuffer buffer) {
+ 
+     final int i = buffer.position();
+     boolean ret = false;
+     if ((buffer.get(tokenLen + i) & 0xff) == ':') {
+ 
+       int j = 0;
+       while (j < tokenLen && token.get(j) == buffer.get(i + j)) {
+         j++;
+       }
+       ret = tokenLen == j;
+     }
+ 
+     return ret;
+   }
+ }

