+               + "                    public Type getRawType() {\n"
+               + "                      return CouchResultSet.class;\n"
+               + "                    }\n"
+               + "\n"
+               + "                    public Type getOwnerType() {\n"
+               + "                      return null;\n"
+               + "                    }\n"
+               + "\n"
+               + "                    public Type[] getActualTypeArguments() {\n"
+               + "                             "
+               + "                          Type key = (Type)"
+               + cmdName
+               + ".this.get(DbKeys.etype.keyType);\n"
+               + "                          Type[]t={key == null ? Object.class : key, (Type)"
+               + cmdName
+               + ".this.get(DbKeys.etype.type)};\n"
+               + "                          return t;\n"
+               + "                    }\n"
+               + "                  });\n"
+               + "            } catch (Exception e) {\n"
